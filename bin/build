#!/bin/bash

cc="gcc"

for arg in "$@"; do declare $arg='1';done

if [[ "${test:-0}" == "1" ]]; then
    echo "[building tests]"
    cc_debug="-g"
    target="build/tests"
    flags="${cc_debug} -std=c89"
    ${cc} ${flags} -o ${target} ./tests/main.c
    exit
fi

if [[ ! -d "./build" ]]; then
    mkdir ./build
else
    rm -rf ./build
    mkdir ./build
fi

cc_sanitize=""
if [[ "${asan:-0}" == "1" ]]; then
    echo "[asan enabled]"
    cc_sanitize="-fsanitize=address"
fi

if [[ "${debug:-0}" == "1" ]]; then
    echo "[debug build]"
    cc_debug="-g"
fi

target="build/editor"
flags="${cc_sanitize} ${cc_debug} -std=c89"

${cc} ${flags} -o ${target} \
    src/main.c \
    src/editor.c \
    src/buffer.c \
    src/cmd.c \
    src/term.c \
    src/file.c
