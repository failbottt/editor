#!/bin/bash

set -euo pipefail

"$(dirname "$0")/build" debug

make_gdbserver_launcher() {
    local launcher
    launcher="$(mktemp "${TMPDIR:-/tmp}/editor-gdbserver.XXXXXX")"
    cat >"${launcher}" <<EOF
#!/bin/bash
set -u

gdbserver --once 127.0.0.1:2345 ./build/editor "\$@"
status=\$?
if [[ "\$status" -eq 0 ]]; then
    exit 0
fi

echo
echo "gdbserver exited with status \${status}"
read -r -p "Press Enter to close this pane..." _
exit "\${status}"
EOF
    chmod +x "${launcher}"
    printf '%s\n' "${launcher}"
}

if ! command -v gdbserver >/dev/null 2>&1; then
    exec gdb -q --args ./build/editor "$@"
fi

gdbserver_launcher="$(make_gdbserver_launcher)"
trap 'rm -f "${gdbserver_launcher}"' EXIT INT TERM

if [[ -n "${TMUX-}" ]]; then
    gdbserver_pane="$(
        tmux split-window -h -P -F '#{pane_id}' \
            -c "$PWD" \
            bash "${gdbserver_launcher}" "$@"
    )"
    tmux split-window -v -t "${gdbserver_pane}" -c "$PWD" \
        nvim ./src/main.c >/dev/null
    sleep 0.5
fi

exec gdb -q \
    -ex 'set debuginfod enabled off' \
    -ex 'target remote 127.0.0.1:2345' \
    ./build/editor
